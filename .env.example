# AtlasAgentBench — Environment Configuration
#
# Copy this file to .env and fill in your API keys.
# Only needed for:
#   - LLM-powered agent execution (when passing an LLM to graph builders)
#   - Groq API calls in the adaptive router and LLM judge
#   - Synthetic task generation via Groq

# Groq API key (free tier available at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Optional: OpenAI key if you want to use GPT models instead
# OPENAI_API_KEY=sk-your-key-here
